<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luma</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <main class="welcome-screen">
        <span class="wordmark">Luma</span>

        <div class="welcome">
            <div class="glow-pair" aria-hidden="true">
                <span class="glow glow-blue"></span>
                <span class="glow glow-pink"></span>
            </div>

            <h1><%= firstName ? `Hey, ${firstName}.` : 'Welcome to Luma.' %></h1>
            <p>Good to see you.</p>

            <% if (firstName) { %>
                <div class="welcome-actions">
                    <a class="welcome-link welcome-link--primary" href="/check-in">
                        Check in
                    </a>
                    <a class="welcome-link welcome-link--secondary" href="/gratitude">
                        Gratitude journal
                    </a>
                </div>

                <form class="signup-form" action="/signout" method="post">
                    <button type="submit">Sign out</button>
                </form>
            <% } else { %>
                <div class="welcome-actions">
                    <a class="welcome-link welcome-link--primary" href="/signin">
                        Sign in
                    </a>
                    <a class="welcome-link welcome-link--secondary" href="/signup">
                        Create an account
                    </a>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>